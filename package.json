{
  "name": "flocklet",
  "productName": "Flocklet",
  "version": "0.2.1",
  "description": "A floating flock of pets for your Claude Code desktop sessions: see what each agent does, answer questions and permissions, watch usage.",
  "author": "Flocklet",
  "homepage": "https://github.com/vrosi21/flocklet",
  "repository": {
    "type": "git",
    "url": "https://github.com/vrosi21/flocklet.git"
  },
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "brand": "node scripts/brand.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron": "45.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.flocklet.app",
    "productName": "Flocklet",
    "artifactName": "Flocklet-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/flocklet.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Flocklet",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vrosi21",
        "repo": "flocklet",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "RELEASE_NOTES.md"
    }
  }
}
